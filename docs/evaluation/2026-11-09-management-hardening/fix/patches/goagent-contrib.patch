@@ -0,0 +1,17 @@
+# 租约事务与提交不确定清理
+
+`tryAcquire` 与 `deleteLease` 在同一 `(ns, id)` 上使用事务级 advisory 排他锁，直到提交或回滚才释放。获取租约的 COMMIT 响应丢失时，清理等待该事务结束，再按完整 `(ns, id, token)` 删除，保留其他持有者的 token。
+
+获取、清理、Save/SaveAll、RemoveScope、PruneRemoved 和 SessionStore 写事务均显式使用 READ COMMITTED，不依赖连接默认隔离级别。清理的 DELETE 和 scope 墓碑检查必须是获锁后的独立语句，不能与加锁合并到同一 SQL/CTE：PostgreSQL 的语句快照在等待前建立。仅拆成两条 SQL 也不足以支持 REPEATABLE READ 的事务快照。依据：[事务隔离](https://www.postgresql.org/docs/current/transaction-iso.html)、[advisory 锁](https://www.postgresql.org/docs/current/explicit-locking.html#ADVISORY-LOCKS)。
+
+RemoveScope 与 PruneRemoved 获锁后重新判定墓碑，重复操作不会因连接默认 RR 使用旧快照而报序列化错误。SessionStore 的追加、批量比较与 Fork 同样依赖获行锁后的已提交状态：追加冲突返回 `ErrSessionConflict`，Fork 复制完整前缀；token 条件和事务行锁仍保护快照写入。这些操作覆盖整个写事务的隔离级别，不修改连接或服务器的默认配置。
+
+获取顺序为 scope 共享锁 → lease 排他锁 → 行锁；清理只取 lease 锁与行锁，不请求 scope 锁，也不因 scope 墓碑跳过清理。lease 使用双 int 键，scope 使用单 bigint 键，两种锁空间互不重叠；哈希碰撞仅增加串行等待，不改变实际行匹配。
+
+清理仍受 `OpTimeout` 限制。数据库不可用、等待超时或清理自身提交结果不确定时，通过 `OnError("delete_lease", err)` 报告，残留租约由 TTL 兜底；这不是无限等待或保证清理必达的协议。串行化要求并发获取者也使用相同租约锁，混用旧实现时不具备该保证。
+
+Lock 的获取尝试同时受调用方 context 和 `OpTimeout` 限制，连接池、scope/lease advisory 等待可以被取消。尚未尝试 INSERT 的失败无需清理；一旦尝试写入，任何错误仍触发独立 `OpTimeout` 的按 token 补偿，调用方取消不会取消补偿。COMMIT 已成功而调用方在登记持有者前取消时，也先清理自身 token 再释放 gate，不登记 owners。取消返回的错误同时包装 `ErrLockUnavailable` 和调用方的 `context.Canceled` / `context.DeadlineExceeded`。因此发生写入不确定性时，返回可能晚于调用方期限，最长还要等待一次补偿期限；成功登记之后的取消仍由调用方负责 unlock。
+
+回归测试使用隔离 schema 与真实事务，观察 `pg_locks` / `pg_blocking_pids` 确认清理在获取事务结束前阻塞，并验证提交、回滚、其他 token、默认 REPEATABLE READ、获取端锁协议及 scope 锁顺序。`TestAcquireUncertainCommitCleanup` 继续覆盖 COMMIT 发出后断开连接的故障。上述测试不重启数据库、不改全局同步复制配置。
+
+`TestLockCancellationDuringAdvisoryWait` 覆盖公开 Lock 的真实 scope/lease 等待、取消及截止时间，确认在阻塞事务释放前返回并且 owners/gates/lease 无残留。`TestLockCancelledAfterCommit` 覆盖收到提交成功和丢失提交响应后的取消及独立补偿。`TestSaveRejectsTombstoneAfterScopeWait`、`TestScopeMaintenanceAfterConcurrentTransaction`、`TestSessionWritesAfterRowWait` 用 RC/RR 默认值对照，验证等锁期间提交后的墓碑拒写、重复删除/回收及会话行锁语义。
diff --git a/durable/pgstore/isolation_test.go b/durable/pgstore/isolation_test.go
new file mode 100644
index 0000000..2139606
--- /dev/null
+++ b/durable/pgstore/isolation_test.go
@@ -0,0 +1,202 @@
+package pgstore
+
+import (
+	"context"
+	"encoding/json"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/stretchr/testify/require"
+
+	"github.com/kart-io/goagent/core/durable"
+	"github.com/kart-io/goagent/core/session"
+	agentErrors "github.com/kart-io/goagent/errors"
+)
+
+func isolationPool(t *testing.T, dsn, schema, isolation string) *pgxpool.Pool {
+	t.Helper()
+	cfg, err := pgxpool.ParseConfig(dsn)
+	require.NoError(t, err)
+	cfg.ConnConfig.RuntimeParams["search_path"] = schema
+	cfg.ConnConfig.RuntimeParams["default_transaction_isolation"] = isolation
+	pool, err := pgxpool.NewWithConfig(context.Background(), cfg)
+	require.NoError(t, err)
+	t.Cleanup(pool.Close)
+	return pool
+}
+
+func TestSaveRejectsTombstoneAfterScopeWait(t *testing.T) {
+	for _, isolation := range []string{"read committed", "repeatable read"} {
+		for _, batch := range []bool{false, true} {
+			name := isolation + "/Save"
+			if batch {
+				name += "All"
+			}
+			t.Run(name, func(t *testing.T) {
+				dsn, schema := newSchema(t)
+				observer := newPool(t, dsn, schema)
+				s := newIdleStore(isolationPool(t, dsn, schema, isolation))
+				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+				defer cancel()
+				view := s.Scope("tenant")
+				for _, id := range []string{"a", "z"} {
+					unlock, err := view.Lock(ctx, id)
+					require.NoError(t, err)
+					defer unlock()
+					require.NoError(t, view.Save(ctx, id, &durable.Snapshot{Version: "before"}))
+				}
+				tx, err := observer.Begin(ctx)
+				require.NoError(t, err)
+				defer tx.Rollback(context.Background())
+				_, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1, 0))`, scopeNS("tenant"))
+				require.NoError(t, err)
+				var saveErr error
+				done := make(chan struct{})
+				go func() {
+					if batch {
+						saveErr = view.SaveAll(ctx,
+							durable.Write{ID: "a", Snapshot: &durable.Snapshot{Version: "after"}},
+							durable.Write{ID: "z", Snapshot: &durable.Snapshot{Version: "after"}})
+					} else {
+						saveErr = view.Save(ctx, "a", &durable.Snapshot{Version: "after"})
+					}
+					close(done)
+				}()
+				defer func() { _ = tx.Rollback(context.Background()); <-done }()
+				waitLeaseBlocked(t, observer, tx.Conn().PgConn().PID(), done)
+				// 模拟墓碑已提交、批量清理中断，仍保留合法 token 与旧快照。
+				_, err = tx.Exec(ctx, `INSERT INTO goagent_durable_scope (ns, removed_at) VALUES ($1, now())`, scopeNS("tenant"))
+				require.NoError(t, err)
+				require.NoError(t, tx.Commit(ctx))
+				<-done
+				require.ErrorIs(t, saveErr, agentErrors.ErrScopeRemoved)
+				for _, id := range []string{"a", "z"} {
+					var raw []byte
+					require.NoError(t, observer.QueryRow(ctx, `SELECT data FROM goagent_durable_snapshot WHERE ns=$1 AND id=$2`, scopeNS("tenant"), id).Scan(&raw))
+					var snapshot durable.Snapshot
+					require.NoError(t, json.Unmarshal(raw, &snapshot))
+					require.Equal(t, "before", snapshot.Version)
+				}
+			})
+		}
+	}
+}
+
+func TestScopeMaintenanceAfterConcurrentTransaction(t *testing.T) {
+	for _, isolation := range []string{"read committed", "repeatable read"} {
+		for _, prune := range []bool{false, true} {
+			name := isolation + "/RemoveScope"
+			if prune {
+				name = isolation + "/PruneRemoved"
+			}
+			t.Run(name, func(t *testing.T) {
+				dsn, schema := newSchema(t)
+				observer := newPool(t, dsn, schema)
+				s := newIdleStore(isolationPool(t, dsn, schema, isolation))
+				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+				defer cancel()
+				ns := scopeNS("tenant")
+				if prune {
+					_, err := observer.Exec(ctx, `INSERT INTO goagent_durable_scope VALUES ($1, now() - interval '1 hour')`, ns)
+					require.NoError(t, err)
+				}
+				tx, err := observer.Begin(ctx)
+				require.NoError(t, err)
+				defer tx.Rollback(context.Background())
+				_, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1, 0))`, ns)
+				require.NoError(t, err)
+				var opErr error
+				done := make(chan struct{})
+				go func() {
+					if prune {
+						opErr = s.PruneRemoved(ctx, time.Minute)
+					} else {
+						opErr = s.RemoveScope(ctx, "tenant")
+					}
+					close(done)
+				}()
+				defer func() { _ = tx.Rollback(context.Background()); <-done }()
+				waitLeaseBlocked(t, observer, tx.Conn().PgConn().PID(), done)
+				if prune {
+					// 另一回收者先完成，等待者必须重新读取墓碑，安全地无操作返回。
+					_, err = tx.Exec(ctx, `DELETE FROM goagent_durable_scope WHERE ns=$1`, ns)
+				} else {
+					// 另一删除者先提交墓碑；重复删除不应报序列化错误或刷新时间。
+					_, err = tx.Exec(ctx, `INSERT INTO goagent_durable_scope VALUES ($1, '2000-01-01T00:00:00Z')`, ns)
+				}
+				require.NoError(t, err)
+				require.NoError(t, tx.Commit(ctx))
+				<-done
+				require.NoError(t, opErr)
+				if prune {
+					var n int
+					require.NoError(t, observer.QueryRow(ctx, `SELECT count(*) FROM goagent_durable_scope WHERE ns=$1`, ns).Scan(&n))
+					require.Zero(t, n)
+				} else {
+					var removed time.Time
+					require.NoError(t, observer.QueryRow(ctx, `SELECT removed_at FROM goagent_durable_scope WHERE ns=$1`, ns).Scan(&removed))
+					require.Equal(t, 2000, removed.Year())
+				}
+			})
+		}
+	}
+}
+
+func TestSessionWritesAfterRowWait(t *testing.T) {
+	for _, isolation := range []string{"read committed", "repeatable read"} {
+		for _, op := range []string{"Append", "AppendAll", "compare", "Fork"} {
+			t.Run(isolation+"/"+op, func(t *testing.T) {
+				dsn, schema := newSchema(t)
+				observer := newPool(t, dsn, schema)
+				s := &SessionStore{root: newIdleStore(isolationPool(t, dsn, schema, isolation))}
+				ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+				defer cancel()
+				event := session.Event{Type: "test", Data: json.RawMessage(`{}`)}
+				_, err := s.Append(ctx, "session", 0, event)
+				require.NoError(t, err)
+				tx, err := observer.Begin(ctx)
+				require.NoError(t, err)
+				defer tx.Rollback(context.Background())
+				plan, err := s.planAppend(session.AppendBatch{ID: "session", Expected: 1, Events: []session.Event{event}})
+				require.NoError(t, err)
+				require.NoError(t, plan.apply(ctx, tx, time.Minute))
+				var writeErr error
+				done := make(chan struct{})
+				go func() {
+					switch op {
+					case "Append":
+						_, writeErr = s.Append(ctx, "session", 1, event)
+					case "AppendAll":
+						_, writeErr = s.AppendAll(ctx, session.AppendBatch{ID: "session", Expected: 1, Events: []session.Event{event}})
+					case "compare":
+						_, writeErr = s.AppendAll(ctx, session.AppendBatch{ID: "session", Expected: 1})
+					case "Fork":
+						writeErr = s.Fork(ctx, "session", "copy", 0)
+					}
+					close(done)
+				}()
+				defer func() { _ = tx.Rollback(context.Background()); <-done }()
+				pid := tx.Conn().PgConn().PID()
+				require.Eventually(t, func() bool {
+					var blocked bool
+					err := observer.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM pg_locks WHERE NOT granted AND $1::integer = ANY(pg_blocking_pids(pid)))`, pid).Scan(&blocked)
+					return err == nil && blocked
+				}, 3*time.Second, 5*time.Millisecond, "必须观察到真实行锁等待")
+				require.NoError(t, tx.Commit(ctx))
+				<-done
+				if op == "Fork" {
+					require.NoError(t, writeErr)
+					events, err := s.Read(ctx, "copy", 0)
+					require.NoError(t, err)
+					require.Len(t, events, 2, "复制获锁后完整的已提交前缀")
+				} else {
+					require.ErrorIs(t, writeErr, agentErrors.ErrSessionConflict)
+				}
+				events, err := s.Read(ctx, "session", 0)
+				require.NoError(t, err)
+				require.Len(t, events, 2)
+			})
+		}
+	}
+}
diff --git a/durable/pgstore/lease_cleanup_test.go b/durable/pgstore/lease_cleanup_test.go
new file mode 100644
index 0000000..6c85df3
--- /dev/null
+++ b/durable/pgstore/lease_cleanup_test.go
@@ -0,0 +1,203 @@
+package pgstore
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/stretchr/testify/require"
+
+	agentErrors "github.com/kart-io/goagent/errors"
+)
+
+// waitLeaseBlocked observes an actual database lock wait, not a scheduling delay.
+func waitLeaseBlocked(t *testing.T, pool *pgxpool.Pool, blocker uint32, done <-chan struct{}) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	tick := time.NewTicker(5 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		select {
+		case <-done:
+			t.Fatal("lease operation returned before the acquiring transaction finished")
+		case <-ctx.Done():
+			t.Fatal("lease operation did not wait on the acquiring transaction")
+		case <-tick.C:
+			var blocked bool
+			err := pool.QueryRow(ctx, `SELECT EXISTS (
+  SELECT 1 FROM pg_locks WHERE locktype = 'advisory' AND NOT granted
+  AND $1::integer = ANY(pg_blocking_pids(pid)))`, blocker).Scan(&blocked)
+			require.NoError(t, err)
+			if blocked {
+				return
+			}
+		}
+	}
+}
+
+func TestDeleteLeaseWaitsForAcquireTransaction(t *testing.T) {
+	for _, ns := range []string{"", scopeNS("tenant")} {
+		for _, isolation := range []string{"read committed", "repeatable read"} {
+			for _, outcome := range []string{"commit", "rollback", "other-token"} {
+				t.Run(ns+"/"+isolation+"/"+outcome, func(t *testing.T) {
+					dsn, schema := newSchema(t)
+					observer := newPool(t, dsn, schema)
+					cfg, err := pgxpool.ParseConfig(dsn)
+					require.NoError(t, err)
+					cfg.ConnConfig.RuntimeParams["search_path"] = schema
+					cfg.ConnConfig.RuntimeParams["default_transaction_isolation"] = isolation
+					pool, err := pgxpool.NewWithConfig(context.Background(), cfg)
+					require.NoError(t, err)
+					t.Cleanup(pool.Close)
+					errors := make(chan error, 1)
+					// No background renewer: only the acquiring transaction can finish this lease.
+					s := &Store{cfg: Config{Pool: pool, OpTimeout: 5 * time.Second,
+						OnError: func(_ string, err error) { errors <- err }}}
+					ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+					defer cancel()
+					tx, err := observer.Begin(ctx)
+					require.NoError(t, err)
+					defer tx.Rollback(context.Background())
+					require.NoError(t, checkScope(ctx, tx, ns))
+					// Two-int advisory keys have a disjoint lock space from the scope's bigint key.
+					_, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtext($1), hashtext($2))`, ns, "run")
+					require.NoError(t, err)
+					token := "ours"
+					if outcome == "other-token" {
+						token = "successor"
+					}
+					_, err = tx.Exec(ctx, `INSERT INTO goagent_durable_lease (ns, id, token, owner, expires_at)
+VALUES ($1, 'run', $2, 'test', now() + interval '1 minute')`, ns, token)
+					require.NoError(t, err)
+					done := make(chan struct{})
+					go func() {
+						s.deleteLease(ns, "run", "ours")
+						close(done)
+					}()
+					// Ensure the worker ends even on an assertion failure before releasing the transaction.
+					defer func() {
+						_ = tx.Rollback(context.Background())
+						<-done
+					}()
+					waitLeaseBlocked(t, observer, tx.Conn().PgConn().PID(), done)
+					if outcome == "rollback" {
+						require.NoError(t, tx.Rollback(ctx))
+					} else {
+						require.NoError(t, tx.Commit(ctx))
+					}
+					select {
+					case <-done:
+					case <-ctx.Done():
+						t.Fatal("cleanup did not finish after the transaction ended")
+					}
+					select {
+					case err := <-errors:
+						t.Fatalf("cleanup failed: %v", err)
+					default:
+					}
+					var tokens []string
+					rows, err := observer.Query(ctx, `SELECT token FROM goagent_durable_lease WHERE ns = $1 AND id = 'run'`, ns)
+					require.NoError(t, err)
+					tokens, err = pgx.CollectRows(rows, pgx.RowTo[string])
+					require.NoError(t, err)
+					if outcome == "other-token" {
+						require.Equal(t, []string{"successor"}, tokens)
+					} else {
+						require.Empty(t, tokens, "cleanup must use a fresh snapshot after waiting")
+					}
+				})
+			}
+		}
+	}
+}
+
+func TestTryAcquireUsesLeaseTransactionLock(t *testing.T) {
+	for _, ns := range []string{"", scopeNS("tenant")} {
+		t.Run(ns, func(t *testing.T) {
+			dsn, schema := newSchema(t)
+			pool := newPool(t, dsn, schema)
+			s := &Store{cfg: Config{Pool: pool, OpTimeout: 5 * time.Second, LeaseTTL: time.Minute}}
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			tx, err := pool.Begin(ctx)
+			require.NoError(t, err)
+			defer tx.Rollback(context.Background())
+			_, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtext($1), hashtext($2))`, ns, "run")
+			require.NoError(t, err)
+			done := make(chan struct{})
+			var acquired bool
+			var acquireErr error
+			go func() {
+				acquired, acquireErr = s.tryAcquire(ctx, ns, "run", "ours")
+				close(done)
+			}()
+			defer func() {
+				_ = tx.Rollback(context.Background())
+				<-done
+			}()
+			waitLeaseBlocked(t, pool, tx.Conn().PgConn().PID(), done)
+			require.NoError(t, tx.Commit(ctx))
+			<-done
+			require.NoError(t, acquireErr)
+			require.True(t, acquired)
+			s.deleteLease(ns, "run", "ours")
+		})
+	}
+}
+
+func TestLeaseCleanupDoesNotWaitForScopeLock(t *testing.T) {
+	dsn, schema := newSchema(t)
+	pool := newPool(t, dsn, schema)
+	errors := make(chan error, 1)
+	s := &Store{cfg: Config{Pool: pool, OpTimeout: 5 * time.Second, LeaseTTL: time.Minute,
+		OnError: func(_ string, err error) { errors <- err }}}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	ns := scopeNS("tenant")
+	_, err := pool.Exec(ctx, `INSERT INTO goagent_durable_lease (ns, id, token, owner, expires_at)
+VALUES ($1, 'run', 'ours', 'test', now() + interval '1 minute')`, ns)
+	require.NoError(t, err)
+	tx, err := pool.Begin(ctx)
+	require.NoError(t, err)
+	defer tx.Rollback(context.Background())
+	_, err = tx.Exec(ctx, `SELECT pg_advisory_xact_lock(hashtextextended($1, 0))`, ns)
+	require.NoError(t, err)
+	done := make(chan struct{})
+	var acquired bool
+	var acquireErr error
+	go func() {
+		acquired, acquireErr = s.tryAcquire(ctx, ns, "next", "next-token")
+		close(done)
+	}()
+	defer func() {
+		_ = tx.Rollback(context.Background())
+		<-done
+	}()
+	pid := tx.Conn().PgConn().PID()
+	waitLeaseBlocked(t, pool, pid, done)
+	var leaseLocked bool
+	require.NoError(t, pool.QueryRow(ctx, `SELECT EXISTS (
+  SELECT 1 FROM pg_locks WHERE locktype = 'advisory' AND granted AND objsubid = 2
+  AND $1::integer = ANY(pg_blocking_pids(pid)))`, pid).Scan(&leaseLocked))
+	require.False(t, leaseLocked, "acquisition must take the scope lock before the lease lock")
+
+	// Cleanup must finish while the exclusive scope lock is still held.
+	s.deleteLease(ns, "run", "ours")
+	select {
+	case err := <-errors:
+		t.Fatalf("cleanup failed while scope was locked: %v", err)
+	default:
+	}
+	var n int
+	require.NoError(t, pool.QueryRow(ctx, `SELECT count(*) FROM goagent_durable_lease WHERE ns = $1 AND id = 'run'`, ns).Scan(&n))
+	require.Zero(t, n)
+	_, err = tx.Exec(ctx, `INSERT INTO goagent_durable_scope (ns, removed_at) VALUES ($1, now())`, ns)
+	require.NoError(t, err)
+	require.NoError(t, tx.Commit(ctx))
+	<-done
+	require.False(t, acquired)
+	require.ErrorIs(t, acquireErr, agentErrors.ErrScopeRemoved)
+}
